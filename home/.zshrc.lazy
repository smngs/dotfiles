# ----------------- PATH --------------------
# Must come first: the checks below rely on a complete PATH

case ${OSTYPE} in
    darwin*)
        # path_helper first, then prepend our own entries
        eval "$(/usr/libexec/path_helper)"
        export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.local/bin:$PATH"
        export PATH="$HOME/.bun/bin:$HOME/.lmstudio/bin:$PATH"

        # Prefer GNU tools over the BSD variants. (N) skips uninstalled ones.
        for _gnubin in /opt/homebrew/opt/{coreutils,findutils,gnu-sed,grep,gnu-tar}/libexec/gnubin(N); do
            export PATH="$_gnubin:$PATH"
        done
        unset _gnubin
        ;;
    linux*)
        # OSS CAD Suite (yosys / nextpnr / openFPGALoader / gowin_pack).
        # Appended, not prepended, so the system python keeps priority.
        [[ -d "$HOME/oss-cad-suite/bin" ]] && export PATH="$PATH:$HOME/oss-cad-suite/bin"
        ;;
esac

[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# ----------------- env --------------------

(( ${+commands[nvim]} )) && export EDITOR='nvim'

export CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=75
export CLAUDE_CODE_NO_FLICKER=1

[[ -f $HOME/.secrets ]] && source $HOME/.secrets

# ----------------- alias --------------------

if (( ${+commands[eza]} )); then
  alias l='eza --icons'
  alias ls='eza --icons'
  alias la='eza --icons -a'
  alias ll='eza --icons -lh'
  alias lla='eza --icons -lah'
fi

(( ${+commands[bat]} ))   && alias cat='bat'
(( ${+commands[hexyl]} )) && alias od='hexyl'
(( ${+commands[procs]} )) && alias ps='procs'
(( ${+commands[yazi]} ))  && alias f='yazi'
# delta is not a drop-in for diff(1); it only takes two paths
(( ${+commands[delta]} )) && alias diff='delta'

alias tree='tree -C'
alias rm='rm -i'
alias mv='mv -i'
alias df='df -h'
alias q='exit'
alias c='clear'

alias claude='claude --permission-mode auto'
alias auto-commit='claude -p "/commit"'
alias auto-pr='claude -p "/pr"'
alias auto-ship='claude -p "/commit-pr"'

alias ..='\cd ..'
alias ..2='\cd ../..'
alias ..3='\cd ../../..'
alias ..4='\cd ../../../..'
alias ..5='\cd ../../../../..'

# ----------------- function -----------------

# Empty Enter shows pwd, ls and git status
function do_enter() {
    if [[ -n "$BUFFER" ]]; then
        # Delegate to zeno so snippet expansion still happens on Enter
        if (( ${+widgets[zeno-auto-snippet-and-accept-line]} )); then
            zle zeno-auto-snippet-and-accept-line
        else
            zle accept-line
        fi
        return 0
    fi
    echo
    echo -e "\e[0;33m--- pwd ---\e[0m"
    pwd
    echo
    echo -e "\e[0;33m--- ls ---\e[0m"
      ls
    if [ "$(git rev-parse --is-inside-work-tree 2> /dev/null)" = 'true' ]; then
        echo
        echo -e "\e[0;33m--- git status ---\e[0m"
        git status -sb
    fi
    echo
    echo
    zle reset-prompt
    return 0
}

zle -N do_enter

# ----------------- zeno -----------------

# sheldon sources zeno before this file, so its widgets already exist
if (( ${+widgets[zeno-auto-snippet]} )); then
    bindkey ' '    zeno-auto-snippet
    bindkey '^I'   zeno-completion
    bindkey '^P'   zeno-completion
    bindkey '^r'   zeno-history-selection
    bindkey '^x^s' zeno-insert-snippet
    bindkey '^x^f' zeno-ghq-cd
fi

# Bound last: do_enter hands off to zeno itself
bindkey '^m' do_enter

# ----------------- ssh -----------------

# rbw-agent serves SSH keys straight from the Bitwarden vault, so no private
# key is written to disk. Start it with `rbw unlock`; falls back to the system
# agent while it is not running.
if (( ${+commands[rbw]} )); then
    for _rbw_sock in \
        "${XDG_RUNTIME_DIR:-}/rbw/ssh-agent-socket" \
        "${${TMPDIR:-/tmp}%/}/rbw-${UID}/ssh-agent-socket"; do
        if [[ -S "$_rbw_sock" ]]; then
            export SSH_AUTH_SOCK="$_rbw_sock"
            # Stable path for tools that do not source this file (e.g. Claude Code),
            # since the real socket lives under a per-session TMPDIR on macOS.
            mkdir -p "$HOME/.local/share/ssh"
            ln -sfn "$_rbw_sock" "$HOME/.local/share/ssh/rbw-agent.sock"
            break
        fi
    done
    unset _rbw_sock

    # A locked vault leaves the agent with no keys, and ssh only reports
    # "Permission denied (publickey)". Unlock and retry instead of failing.
    # 255 is ssh's own error code, as opposed to a remote command's status.
    _rbw_retry() {
        local cmd="$1"; shift
        command "$cmd" "$@"
        local rc=$?
        (( rc == 255 )) || return $rc
        rbw unlocked >/dev/null 2>&1 && return $rc
        print -u2 -P "%F{yellow}[$cmd] vault is locked; unlocking and retrying%f"
        rbw unlock || return $rc
        command "$cmd" "$@"
    }

    ssh()  { _rbw_retry ssh "$@" }
    scp()  { _rbw_retry scp "$@" }
    sftp() { _rbw_retry sftp "$@" }
fi

# ----------------- Rust -----------------

(( ${+commands[sccache]} )) && export RUSTC_WRAPPER=sccache

# ----------------- fzf -----------------

# ZENO_* are exported in .zshrc, before sheldon sources the plugin
export FZF_DEFAULT_OPTS="--height 30% --layout=reverse --border --ansi --margin 1,3"

# ----------------- autoloads -----------------

autoload -Uz cdr
autoload -Uz chpwd_recent_dirs
autoload -Uz add-zsh-hook

add-zsh-hook chpwd chpwd_recent_dirs

# ----------------- completion -----------------

# Skip the security check while the dump is fresh (< 24h)
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi
